rules_version = '2';

// Security rules for the 2244 app's Firestore data.
// Mirror of firebase/firestore.rules. The deployable copy under
// firebase/firestore.rules is the source of truth used by `firebase deploy`;
// this file exists at the repo root so editor tooling and tests can pick up
// the same shape. Keep them in sync.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidBoardId(boardId) {
      return boardId.matches('^(global|daily:[0-9]{4}-[0-9]{2}-[0-9]{2}|mode:[a-zA-Z0-9_]+)$');
    }

    function validGemPayload(data) {
      // Sanity bound on gem balance — prevents trivial inflation.
      // Tighten further with a Cloud Function that validates deltas.
      return data.gems is number
        && data.gems >= 0
        && data.gems <= 100000000;
    }

    function validReport(data) {
      return data.reportedPlayerName is string
        && data.reportedPlayerName.size() <= 100
        && data.reason is string
        && data.reason.size() <= 200
        && (!('additionalDetails' in data) || data.additionalDetails.size() <= 2000);
    }

    function validSocialPost(data) {
      return data.authorId is string
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 80
        && data.avatarID is string
        && data.avatarID.size() <= 80
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 500
        && data.statText is string
        && data.statText.size() <= 80
        && data.reactionCount is number
        && data.reactionCount >= 0
        && data.commentCount is number
        && data.commentCount >= 0;
    }

    function validSocialComment(data) {
      return data.authorId is string
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 80
        && data.avatarID is string
        && data.avatarID.size() <= 80
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 500
        && data.likes is number
        && data.likes >= 0;
    }

    function validReaction(data) {
      return data.uid is string
        && data.uid == request.auth.uid;
    }

    function validFamilyInvite(data) {
      return data.senderId is string
        && data.senderId == request.auth.uid
        && data.participantIds is list
        && data.participantIds.hasAll([request.auth.uid])
        && data.displayName is string
        && data.displayName.size() <= 80
        && data.emailOrCode is string
        && data.emailOrCode.size() <= 120
        && data.status is string
        && data.status.size() <= 40;
    }

    function validPostReactionCountTransition(postId) {
      let reactionPath = /databases/$(database)/documents/socialFeed/$(postId)/reactions/$(request.auth.uid);
      return request.resource.data.commentCount == resource.data.commentCount
        && (
          (
            request.resource.data.reactionCount == resource.data.reactionCount + 1
            && !exists(reactionPath)
            && existsAfter(reactionPath)
          )
          || (
            request.resource.data.reactionCount == resource.data.reactionCount - 1
            && exists(reactionPath)
            && !existsAfter(reactionPath)
          )
        );
    }

    function validPostCommentCountTransition(postId) {
      let commentPath = /databases/$(database)/documents/socialFeed/$(postId)/comments/$(request.resource.data.lastCommentId);
      return request.resource.data.reactionCount == resource.data.reactionCount
        && request.resource.data.commentCount == resource.data.commentCount + 1
        && request.resource.data.lastCommentId is string
        && existsAfter(commentPath)
        && getAfter(commentPath).data.authorId == request.auth.uid;
    }

    function validCommentLikeCountTransition(postId, commentId) {
      let reactionPath = /databases/$(database)/documents/socialFeed/$(postId)/comments/$(commentId)/reactions/$(request.auth.uid);
      return (
          request.resource.data.likes == resource.data.likes + 1
          && !exists(reactionPath)
          && existsAfter(reactionPath)
        )
        || (
          request.resource.data.likes == resource.data.likes - 1
          && exists(reactionPath)
          && !existsAfter(reactionPath)
        );
    }

    function isValidUserProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['displayName', 'username', 'avatarID', 'friendCode', 'createdAt'])
        && data.displayName is string
        && data.displayName.size() <= 50
        && data.displayName.size() > 0
        && data.username is string
        && data.username.size() >= 3
        && data.username.size() <= 32
        && data.avatarID is string
        && data.avatarID.size() <= 80
        && data.friendCode is string
        && data.friendCode.size() <= 32
        && (!('countryCode' in data) || (data.countryCode is string && data.countryCode.size() <= 8))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32));
    }

    // ------------------------------------------------------------
    // /players/{uid} — gem balance + per-player progress + IAP mirror.
    // Player documents are keyed by Firebase Auth UID.
    // ------------------------------------------------------------
    match /players/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validGemPayload(request.resource.data);
      allow delete: if false;

      match /progress/{document=**} {
        allow read, write: if isOwner(uid);
      }

      // Per-player leaderboard metadata (NOT the public leaderboard entries).
      match /leaderboards/{board=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(uid);
      }

      // Receipt mirror written by PurchaseService.onVerifiedPurchase.
      match /purchases/{txnId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }
    }

    // ------------------------------------------------------------
    // /reports/{id} — player abuse reports written by FirestoreReportService.
    // Append-only from clients; reads are server-only (admin SDK / Cloud
    // Functions can read freely).
    // ------------------------------------------------------------
    match /reports/{id} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && validReport(request.resource.data);
      allow read, update, delete: if false;
    }

    // ------------------------------------------------------------
    // /leaderboards/{boardId} — public board metadata. Boards themselves
    // are bootstrapped by Cloud Functions; clients can only read.
    // ------------------------------------------------------------
    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if false;

      // /leaderboards/{boardId}/scores/{uid}:
      // Public read so the leaderboard UI can list. Writes are gated to the
      // submitScore Cloud Function — clients cannot bypass server-side
      // validation by writing here directly.
      match /scores/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ------------------------------------------------------------
    // /users/{uid} — optional public profile (display name, avatar).
    // ------------------------------------------------------------
    match /users/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidUserProfile();
    }

    // ------------------------------------------------------------
    // /socialFeed/{postId} — authenticated social feed posts.
    // Reactions and comments are keyed by the acting user's auth UID.
    // ------------------------------------------------------------
    match /socialFeed/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && validSocialPost(request.resource.data);
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactionCount',
          'commentCount',
          'lastCommentId',
          'updatedAt'
        ])
        && request.resource.data.reactionCount is number
        && request.resource.data.reactionCount >= 0
        && request.resource.data.commentCount is number
        && request.resource.data.commentCount >= 0
        && (
          validPostReactionCountTransition(postId)
          || validPostCommentCountTransition(postId)
        );
      allow delete: if false;

      match /reactions/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(uid) && validReaction(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && validSocialComment(request.resource.data);
        allow update: if isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'updatedAt'])
          && request.resource.data.likes is number
          && request.resource.data.likes >= 0
          && validCommentLikeCountTransition(postId, commentId);
        allow delete: if false;

        match /reactions/{uid} {
          allow read: if isAuthenticated();
          allow create, update: if isOwner(uid) && validReaction(request.resource.data);
          allow delete: if isOwner(uid);
        }
      }
    }

    // ------------------------------------------------------------
    // /familyInvites/{inviteId} — invite records visible only to
    // sender/recipient participants.
    // ------------------------------------------------------------
    match /familyInvites/{inviteId} {
      allow read: if isAuthenticated()
        && resource.data.participantIds is list
        && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if isAuthenticated() && validFamilyInvite(request.resource.data);
      allow update, delete: if false;
    }

    // ------------------------------------------------------------
    // Read-only client-visible config & curated content.
    // ------------------------------------------------------------
    match /settings/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /dailyChallenges/{date} {
      allow read: if true;
      allow write: if false;
    }

    // Default-deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
