rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isValidBoardId(boardId) {
      // Allow global, daily:YYYY-MM-DD, and mode:modeName formats
      return boardId.matches('^(global|daily:[0-9]{4}-[0-9]{2}-[0-9]{2}|mode:[a-zA-Z0-9_]+)$');
    }
    
    // Leaderboards collection
    match /leaderboards/{boardId} {
      // Board documents are readable by all users
      allow read: if true;
      
      // Board documents can only be created/updated by Cloud Functions (service account)
      allow write: if false;
      
      // Scores subcollection
      match /scores/{uid} {
        // Anyone can read leaderboard scores
        allow read: if true;
        
        // Only Cloud Functions can write scores (prevents client tampering)
        // This forces all score submissions to go through the server-authoritative function
        allow write: if false;
      }
    }
    
    // User profiles (optional - for storing additional user data)
    match /users/{uid} {
      // Users can read their own profile and others (for display names, etc.)
      allow read: if true;
      
      // Users can only update their own profile
      allow write: if isOwner(uid) && isValidUserProfile();
    }
    
    // Validate user profile data
    function isValidUserProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['displayName', 'createdAt']) &&
             data.displayName is string &&
             data.displayName.size() <= 50 &&
             data.displayName.size() > 0;
    }
    
    // Global app settings (read-only for clients)
    match /settings/{document} {
      allow read: if true;
      allow write: if false; // Only admins via Cloud Functions
    }
    
    // Daily challenges or special events (optional)
    match /dailyChallenges/{date} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can create daily challenges
    }
    
    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}